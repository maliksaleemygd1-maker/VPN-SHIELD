{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VpnServerNode",
  "type": "object",
  "required": ["id", "country_code", "country_name", "city_name", "endpoint_ip", "port", "public_key", "is_active"],
  "properties": {
    "id": { "type": "string" },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "country_name": { "type": "string" },
    "city_name": { "type": "string" },
    "endpoint_ip": { "type": "string" },
    "port": { "type": "integer", "default": 51820 },
    "public_key": { "type": "string" },
    "current_load_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "avg_latency_ms": { "type": "number", "minimum": 0 },
    "packet_loss_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "capacity_mbps": { "type": "integer" },
    "supports_dedicated_ip": { "type": "boolean" },
    "is_active": { "type": "boolean" }
  }
}
